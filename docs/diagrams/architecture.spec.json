{
  "groups": [
    { "id": "clients", "kind": "clients", "name": "Clients", "children": ["agent", "browser"] },
    { "id": "infra", "kind": "stateless", "name": "Infra you run (no state, no keys)", "children": ["relay", "oauth"] },
    { "id": "github", "kind": "database", "name": "GitHub (only state)", "children": ["branch", "docref", "comments"] }
  ],
  "tables": [
    { "id": "agent", "kind": "component", "name": "Agent (local git)", "fields": [] },
    { "id": "browser", "kind": "component", "name": "Browser: CM6 + Automerge replica", "focus": true, "fields": [] },
    { "id": "relay", "kind": "component", "name": "sync relay", "fields": [] },
    { "id": "oauth", "kind": "component", "name": "OAuth exchange fn", "fields": [] },
    { "id": "branch", "kind": "ref", "name": "refs/heads/<branch>", "focus": true, "fields": [
      { "name": "<path>", "type": "markdown" },
      { "name": "<!--rl:id-->…<!--/rl:id-->", "type": "comment range" },
      { "name": "<!--rl:id @login: … -->", "type": "thread, at doc end" } ] },
    { "id": "docref", "kind": "ref", "name": "refs/red-letter/v1/<sha1 branch>/<sha1 path>", "fields": [
      { "name": "doc.automerge", "type": "blob" },
      { "name": "meta.json", "type": "docId, commit, heads" } ] },
    { "id": "comments", "kind": "branch", "name": "red-letter/comments/<sha1 branch>/<sha1 path>", "fields": [
      { "name": "<path>", "type": "doc + new comments" },
      { "name": "open PR", "type": "into a protected <branch>" } ] }
  ],
  "edges": [
    { "from": "agent", "to": "branch", "label": "git push / pull" },
    { "from": "agent", "to": "comments", "label": "gh pr" },
    { "from": "browser", "to": "relay", "label": "ws ops" },
    { "from": "browser", "to": "oauth", "label": "token" },
    { "from": "browser", "to": "branch", "label": "poll ref / updateRefs", "focus": true },
    { "from": "browser", "to": "docref", "label": "load / updateRefs" },
    { "from": "browser", "to": "comments", "label": "comments if protected" }
  ]
}
